generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String
  createdAt     DateTime        @default(now())
  subscriptions Subscription[]

  @@map("user")
}

model Subscription {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  name           String
  provider       String?  // e.g. Netflix, Spotify
  category       String?  // e.g. Entertainment, Utilities
  amountCents    Int      // store as integer cents
  currency       String   @default("USD")
  billingPeriod  String   @default("monthly") // monthly, yearly, weekly, etc.
  nextChargeDate DateTime
  isTrial        Boolean  @default(false)
  trialEndDate   DateTime?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("subscription")
}

